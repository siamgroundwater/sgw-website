# Create a verified sender in Resend, then copy this file to .env.local.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Siam Groundwater Website <website@your-verified-domain.com>
CONTACT_TO_EMAIL=sgw_th@outlook.com

# SGW CMS. Keep these values server-side and use a separate database per environment.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?appName=siamgroundwater
MONGODB_DB=siamgroundwater
CMS_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CMS_COOKIE_SECURE=true
CRON_SECRET=replace-with-a-random-secret-at-least-24-characters

# Private CMS image storage. Never expose the API secret to client-side code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
CLOUDINARY_ROOT_FOLDER=siamgroundwater/cms
# Keep server-routed uploads at 4 MB or below for common serverless hosts.
CLOUDINARY_MAX_FILE_SIZE_MB=4

# Used only by `npm run seed:cms-admin`; do not commit real credentials.
CMS_SEED_USERNAME=admin
CMS_SEED_PASSWORD=
CMS_SEED_DISPLAY_NAME=SGW Administrator

# CMS tests allocate their own temporary database, accounts, and local server.
# Optional local test port; the configured database is never the test target.
CMS_E2E_PORT=3107

# Optional base64-encoded 32-byte backup key, kept separately from backup archives.
# If absent, the backup tool creates an ignored .cms-backups/recovery.key locally.
CMS_BACKUP_KEY=
